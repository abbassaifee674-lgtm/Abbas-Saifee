# ==============================================================================
# JobPilot - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Abbas's Authorized Account (Single-User Lockdown)
# ------------------------------------------------------------------------------
ALLOWED_EMAIL=abbassaifee674@gmail.com
NEXT_PUBLIC_ALLOWED_EMAIL=abbassaifee674@gmail.com

# Base App URL (e.g., http://localhost:3000 for local, https://jobpilot.vercel.app for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Firebase Console -> Project Settings -> General)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (Server-Side)
# Service Account JSON fields (Project Settings -> Service accounts -> Generate new private key)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Note: For private key with newline characters in Vercel, wrap in double quotes or replace newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API (Free Tier)
# Get a free key at https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key
# Default free flash model: gemini-2.0-flash or gemini-1.5-flash
AI_MODEL=gemini-2.0-flash

# Optional alternative providers (if swapping from Gemini later):
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 4. Gmail API OAuth2 Credentials (Abbas's Personal Gmail Sender Account)
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI must include: http://localhost:3000/api/auth/gmail/callback
# and https://your-production-domain.vercel.app/api/auth/gmail/callback
# ------------------------------------------------------------------------------
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Master encryption secret for encrypting stored Gmail refresh tokens at rest (32+ character random string)
ENCRYPTION_SECRET=generate_a_secure_32_character_random_hex_or_string_here_123456

# ------------------------------------------------------------------------------
# 5. Free Job Finding APIs
# ------------------------------------------------------------------------------
# Adzuna API (Free signup at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble API (Free signup at https://jooble.org/api/about)
JOOBLE_API_KEY=

# Careerjet API (Free partner signup)
CAREERJET_AFFID=

# Hunter.io (Optional free tier: 25 searches/month at https://hunter.io)
HUNTER_API_KEY=

# ------------------------------------------------------------------------------
# 6. Cron Security Key
# Secret used by Vercel Cron to trigger the job finder without public unauthorized calls
# ------------------------------------------------------------------------------
CRON_SECRET=jobpilot_secure_cron_secret_token_123456789

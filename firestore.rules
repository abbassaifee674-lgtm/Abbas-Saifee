rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: checks if user is authenticated and is specifically Abbas Saifee
    function isAbbas() {
      return request.auth != null && 
             request.auth.token.email.lower() == 'abbassaifee674@gmail.com';
    }

    // User Profile and CV storage documents (base64 CV stored directly in Firestore, zero Storage bucket needed)
    match /users/{userId}/{document=**} {
      allow read, write: if isAbbas();
    }

    // Settings collection: only Abbas can read/write his user profile and settings
    match /settings/{userId} {
      allow read, write: if isAbbas() && request.auth.uid == userId;
    }

    // Leads collection: only Abbas can read, create, update, or delete job leads
    match /leads/{leadId} {
      allow read, write: if isAbbas();
    }

    // Run logs collection: job hunter audit trail
    match /run_logs/{logId} {
      allow read: if isAbbas();
      allow write: if isAbbas();
    }

    // Rate limits / daily send counter
    match /send_quotas/{dateKey} {
      allow read, write: if isAbbas();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

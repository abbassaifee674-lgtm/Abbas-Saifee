rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: checks if user is authenticated and is specifically Abbas Saifee
    function isAbbas() {
      return request.auth != null && 
             request.auth.token.email.lower() == 'abbassaifee674@gmail.com';
    }

    // 1. User CV & parsed profile storage (Free Spark Plan • no Storage bucket needed)
    match /users/{userId}/cv/{document=**} {
      allow read, write: if isAbbas();
    }
    match /users/{userId}/cv_chunks/{document=**} {
      allow read, write: if isAbbas();
    }

    // 2. Settings collection: only Abbas can read/write his user profile and settings
    match /settings/{userId} {
      allow read, write: if isAbbas();
    }

    // 3. Leads collection: only Abbas can read, create, update, or delete job leads
    match /leads/{leadId} {
      allow read, write: if isAbbas();
    }

    // 4. Run logs collection: job hunter audit trail (read-only for Abbas in client)
    match /run_logs/{logId} {
      allow read: if isAbbas();
      allow write: if isAbbas();
    }

    // 5. Rate limits / daily send counter
    match /send_quotas/{dateKey} {
      allow read, write: if isAbbas();
    }

    // 6. STRICT SERVER-ONLY COLLECTIONS:
    // Client SDK has ZERO read or write access. Admin SDK bypasses client security rules.
    match /private_tokens/{doc} {
      allow read, write: if false;
    }
    match /api_counters/{doc} {
      allow read, write: if false;
    }
    match /cron_state/{doc} {
      allow read, write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
